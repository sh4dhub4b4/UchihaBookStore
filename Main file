def Customer (income):
  allWorksheet = worksheet.get_all_values()
  df = pd.DataFrame(allWorksheet)
  print("All the book's that we are offering for this semester are here.\n")
  print("Check which book you want to purchase")
  print()
  print("\t|\t|")
  print("\tV\tV")
  print(df)
  print()

  No_book=int(input("Please enter which book you want to buy.\nN.B. Don't enter anything invalid.\n"))
  name=worksheet.cell(No_book+1,2).value   # here index is 1 based indexing
  while (No_book < 1 or No_book > len(Books) or name == "Removed" ) :
    No_book=int(input("Told you not to mess with me. Now try again ;)\n"))
    name=worksheet.cell(No_book+1,2).value   # here index is 1 based indexing

  price=int(worksheet.cell(No_book+1,4).value) # price initially is string

  # name is STRING  value
  print(f"The price of {name} is {price}$\n")

  if input("Do you want to purchase it ?\nType y for purchasing the following book.\n") =="y" :
    # print("kaam hoise    ")

    limit=int(worksheet.cell(No_book+1,3).value)
    if limit==0 :
      print("Out of Stock")
      if input("Do you want to try other books ? \nType y to continue :") =="y":
        Customer(income)
      else :
        print("Thanks for Visiting Uchiha Library.\n\tInfinite Sukoyomi!!!")
        return income

    n = int(input("How many do you want to buy ?\n"))

    if n>0 and n<=limit :
      print(f"{name} is Sold to you!!!!")
      income += n*price
      worksheet.update_cell(No_book+1,3,limit-n)
    else:
      print(f"Sorry we can\'t give you {n} {name}\'s.")
      if input("Do you want to try other books ? \nType y to continue :") =="y":
        Customer(income)
      else :
        print("Thanks for Visiting Uchiha Library.\n Infinite Sukoyomi!!!")
        return income

  else :
    print("Thanks for Visiting Uchiha Library.\n Amaterasu!!! ")


  return income


